rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection (Profile and approvals)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Attendance Collection (Punch in/out records)
    match /attendance/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Assignments / Dispatched Tasks
    match /assignments/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Inspections / Audit Dossiers
    match /inspections/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Incidents / Hazard Reports
    match /incidents/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Leave Requests
    match /leave_requests/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Broadcasts
    match /broadcasts/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Statutory Forms
    match /statutory_forms/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Fallback rule for any other collection
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
